{
  "name": "mfitness",
  "version": "1.0.0",
  "description": "MFitness responsive website built using HTML5, CSS3 and JavaScript.",
  "scripts": {
    "watch:sass": "sass sass/main.scss css/style.css --watch",
    "prefix:css": "postcss css/style.css --use autoprefixer -o css/style.css",
    "parcel": "parcel build index.html --dist-dir dist",
    "build": "npm run prefix:css && npm run parcel",
    "dev": "parcel index.html"
  },
  "author": "Manoranjan",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "parcel": "^2.16.4",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "sass": "^1.92.1"
  },
  "dependencies": {
    "aos": "^3.0.0-beta.6",
    "leaflet": "^1.9.4"
  }
}
